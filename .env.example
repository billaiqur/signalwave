# ── Database ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=harassment_db
POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_SCHEMA=harassment_tracker

# ── App settings ───────────────────────────────────────────────
AUTO_HIDE_COMMENTS=true
POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO

# ── URLs ────────────────────────────────────────────────────────
# FRONTEND_URL: where your static site is served (GitHub Pages in production)
FRONTEND_URL=https://billaiqur.github.io/signalwave
# BACKEND_URL: where this FastAPI server is deployed (Render/Railway in production)
BACKEND_URL=http://localhost:8001

# ── JWT Authentication ──────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret

# ── Google OAuth ────────────────────────────────────────────────
# Used for TWO purposes:
#   1. "Continue with Google" login on index.html (scope: openid email profile)
#   2. YouTube account connection on onboarding Step 2 (scope: youtube.force-ssl)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Facebook / Meta App ─────────────────────────────────────────
# Used for TWO purposes:
#   1. "Continue with Facebook" login on index.html (scope: email public_profile)
#   2. Meta account connection on onboarding Step 2 (scope: pages + instagram)
# Get from: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ── Meta Graph API ──────────────────────────────────────────────
GRAPH_API_VERSION=v19.0

# ── YouTube OAuth mode ──────────────────────────────────────────
YOUTUBE_AUTH_MODE=oauth

# ── AI Detection Provider ───────────────────────────────────────
# Choose ONE: openai | gemini | ollama
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini (uncomment to use instead of OpenAI)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# Ollama — local, free, no API key needed (uncomment to use)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.3

POSTGRES_PORT=5432
POSTGRES_DB=harassment_db
POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_SCHEMA=harassment_tracker

# ── App settings ───────────────────────────────────────────────
AUTO_HIDE_COMMENTS=true
POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO

# ── Meta Graph API (Facebook + Instagram) ──────────────────────
# Credentials are stored in the DB via: python scripts/manage.py add-credentials
# The only env var needed here is the API version:
GRAPH_API_VERSION=v19.0

# ── YouTube ────────────────────────────────────────────────────
# Set to "oauth" to enable comment moderation (hide/delete).
# OAuth credentials are stored in the DB via: python scripts/manage.py add-credentials
YOUTUBE_AUTH_MODE=oauth

# ── AI Detection Provider ───────────────────────────────────────
# Choose ONE: openai | gemini | ollama
AI_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini (uncomment to use instead of OpenAI)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# Ollama — local, free, no API key needed (uncomment to use)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.3
