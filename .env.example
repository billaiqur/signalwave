# ── Database ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=harassment_db
POSTGRES_USER=tracker_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_SCHEMA=harassment_tracker

# ── App settings ───────────────────────────────────────────────
AUTO_HIDE_COMMENTS=true
POLL_INTERVAL_SECONDS=300
LOG_LEVEL=INFO

# ── Meta Graph API (Facebook + Instagram) ──────────────────────
# Credentials are stored in the DB via: python scripts/manage.py add-credentials
# The only env var needed here is the API version:
GRAPH_API_VERSION=v19.0

# ── YouTube ────────────────────────────────────────────────────
# Set to "oauth" to enable comment moderation (hide/delete).
# OAuth credentials are stored in the DB via: python scripts/manage.py add-credentials
YOUTUBE_AUTH_MODE=oauth

# ── AI Detection Provider ───────────────────────────────────────
# Choose ONE: openai | gemini | ollama
AI_PROVIDER=openai

# OpenAI (default)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini (uncomment to use instead of OpenAI)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# Ollama — local, free, no API key needed (uncomment to use)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.3
